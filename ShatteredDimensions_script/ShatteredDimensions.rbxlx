					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">ContentService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">553c5fda893a22240afb318a000003e8</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000014">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local DataService = {}

local profiles = {}
local dirty = {}
local loading = {}
local store = nil
local warnedSave = false

local function profileKey(userId)
	return "player_" .. tostring(userId)
end

local function sanitizeProfile(raw)
	local profile = Util.mergeDefaults(Config.getDefaultProfile(), raw)

	profile.echoes = math.max(0, math.floor(tonumber(profile.echoes) or Config.Economy.StartingEchoes))
	profile.totalPlaySeconds = math.max(0, math.floor(tonumber(profile.totalPlaySeconds) or 0))
	profile.roundsPlayed = math.max(0, math.floor(tonumber(profile.roundsPlayed) or 0))
	profile.roundsWon = math.max(0, math.floor(tonumber(profile.roundsWon) or 0))
	profile.kills = math.max(0, math.floor(tonumber(profile.kills) or 0))

	local ownedSkins = {}
	if type(profile.ownedSkins) == "table" then
		for _, skinId in ipairs(profile.ownedSkins) do
			if type(skinId) == "string" and Config.getSkin(skinId) and Config.getSkin(skinId).price > 0 then
				if not Util.tableFind(ownedSkins, skinId) then
					table.insert(ownedSkins, skinId)
				end
			end
		end
	end
	profile.ownedSkins = ownedSkins

	local ownedEmotions = {}
	if type(profile.ownedEmotions) == "table" then
		for _, emotionId in ipairs(profile.ownedEmotions) do
			if type(emotionId) == "string" and Config.getEmotion(emotionId) and Config.getEmotion(emotionId).price > 0 then
				if not Util.tableFind(ownedEmotions, emotionId) then
					table.insert(ownedEmotions, emotionId)
				end
			end
		end
	end
	profile.ownedEmotions = ownedEmotions

	local savior = Config.getCharacter(profile.selectedSavior)
	if not savior or savior.role ~= Config.Roles.Savior then
		local defaultSavior = Config.getCharacterForRole(Config.Roles.Savior)
		profile.selectedSavior = defaultSavior.id
	end

	local lostSoul = Config.getCharacter(profile.selectedLostSoul)
	if not lostSoul or lostSoul.role ~= Config.Roles.LostSoul then
		local defaultLostSoul = Config.getCharacterForRole(Config.Roles.LostSoul)
		profile.selectedLostSoul = defaultLostSoul.id
	end

	local saviorSkin = Config.getSkin(profile.selectedSaviorSkin)
	if not saviorSkin or saviorSkin.role ~= Config.Roles.Savior then
		profile.selectedSaviorSkin = Config.getDefaultSkin(Config.Roles.Savior).id
	elseif saviorSkin.price > 0 and not Util.tableFind(profile.ownedSkins, saviorSkin.id) then
		profile.selectedSaviorSkin = Config.getDefaultSkin(Config.Roles.Savior).id
	end

	local lostSoulSkin = Config.getSkin(profile.selectedLostSoulSkin)
	if not lostSoulSkin or lostSoulSkin.role ~= Config.Roles.LostSoul then
		profile.selectedLostSoulSkin = Config.getDefaultSkin(Config.Roles.LostSoul).id
	elseif lostSoulSkin.price > 0 and not Util.tableFind(profile.ownedSkins, lostSoulSkin.id) then
		profile.selectedLostSoulSkin = Config.getDefaultSkin(Config.Roles.LostSoul).id
	end

	local emotion = Config.getEmotion(profile.selectedEmotion)
	if not emotion then
		profile.selectedEmotion = Config.Emotions[1].id
	elseif emotion.price > 0 and not Util.tableFind(profile.ownedEmotions, emotion.id) then
		profile.selectedEmotion = Config.Emotions[1].id
	end

	return profile
end

local function fetchSavedProfile(userId)
	if not store then
		return nil
	end

	local lastError
	for attempt = 1, Config.Data.LoadRetries do
		local ok, result = pcall(function()
			return store:GetAsync(profileKey(userId))
		end)

		if ok then
			return result
		end

		lastError = result
		if attempt < Config.Data.LoadRetries then
			task.wait(1)
		end
	end

	warn("[Shattered Dimensions] Не удалось загрузить профиль " .. tostring(userId) .. ": " .. tostring(lastError))
	return nil
end

function DataService.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.Data.StoreName)
	end)
	if ok then
		store = result
	else
		warn("[Shattered Dimensions] DataStore недоступен, профили будут временными: " .. tostring(result))
	end

	task.spawn(function()
		local lastSave = os.clock()
		while true do
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				local profile = profiles[player.UserId]
				if profile then
					profile.totalPlaySeconds += 1
					dirty[player.UserId] = true
				end
			end

			if os.clock() - lastSave >= Config.Data.SaveIntervalSeconds then
				lastSave = os.clock()
				for _, player in ipairs(Players:GetPlayers()) do
					local profile = profiles[player.UserId]
					if profile and dirty[player.UserId] then
						DataService.save(player)
					end
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local userId = player.UserId
		local profile = profiles[userId]
		if not profile then
			return
		end

		DataService.save(player)
		-- Профиль намеренно остаётся в памяти сервера: при быстром реджойне
		-- игрок продолжит с тем же прогрессом, а данные не потеряются.
		dirty[userId] = false
		loading[userId] = nil
	end)

	game:BindToClose(function()
		for _, player in ipairs(Players:GetPlayers()) do
			DataService.save(player)
		end
		if not store then
			return
		end
		-- Даём Roblox время завершить SetAsync.
		task.wait(2)
	end)
end

function DataService.load(player)
	local userId = player.UserId
	if profiles[userId] then
		return profiles[userId]
	end
	if loading[userId] then
		local waited = 0
		while loading[userId] and waited < 15 do
			task.wait(0.1)
			waited += 0.1
		end
		return profiles[userId]
	end

	loading[userId] = true
	local saved = fetchSavedProfile(userId)
	local profile = sanitizeProfile(saved)
	profiles[userId] = profile
	loading[userId] = nil
	dirty[userId] = false
	return profile
end

function DataService.get(player)
	if not player then
		return nil
	end
	return profiles[player.UserId]
end

function DataService.getByUserId(userId)
	return profiles[userId]
end

function DataService.markDirty(player)
	if player then
		dirty[player.UserId] = true
	end
end

function DataService.save(player)
	if not player or not store then
		return false
	end

	local userId = player.UserId
	local profile = profiles[userId]
	if not profile then
		return false
	end

	local snapshot = Util.deepCopy(profile)
	local ok, result = pcall(function()
		store:SetAsync(profileKey(userId), snapshot)
	end)

	if ok then
		dirty[userId] = false
		return true
	end

	if not warnedSave then
		warnedSave = true
		warn("[Shattered Dimensions] Не удалось сохранить профиль: " .. tostring(result))
	end
	return false
end

function DataService.addEchoes(player, amount)
	local profile = DataService.get(player)
	if not profile then
		return 0
	end

	profile.echoes = math.max(0, profile.echoes + math.floor(amount or 0))
	DataService.markDirty(player)
	return profile.echoes
end

function DataService.getPublicProfile(player)
	local profile = DataService.get(player)
	if not profile then
		return nil
	end

	return {
		echoes = profile.echoes,
		ownedSkins = table.clone(profile.ownedSkins),
		ownedEmotions = table.clone(profile.ownedEmotions),
		selectedSavior = profile.selectedSavior,
		selectedLostSoul = profile.selectedLostSoul,
		selectedSaviorSkin = profile.selectedSaviorSkin,
		selectedLostSoulSkin = profile.selectedLostSoulSkin,
		selectedEmotion = profile.selectedEmotion,
		totalPlaySeconds = profile.totalPlaySeconds,
		roundsPlayed = profile.roundsPlayed,
		roundsWon = profile.roundsWon,
		kills = profile.kills,
	}
end

return DataService
]]></ProtectedString>
					<string name="ScriptGuid">{E5F29140-7BBD-4AE3-84BA-2F0038124B50}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">DataService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">553c5fda893a22240afb318a000003e9</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000015">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MapService = require(script.Parent:WaitForChild("MapService"))

local LobbyService = {}

local remotesFolder
local openShopRemote
local notificationRemote

local function makePart(parent, name, size, cframe, color, material)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = true
	part.CanQuery = true
	part.CanTouch = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color or Color3.fromRGB(70, 73, 79)
	part.Material = material or Enum.Material.Concrete
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function createNpc()
	local existing = Workspace:FindFirstChild("SD_Curator")
	if existing then
		existing:Destroy()
	end

	local root = MapService.getNpcStand()
	local model = Instance.new("Model")
	model.Name = "SD_Curator"

	local legs = makePart(model, "Legs", Vector3.new(3.6, 4, 1.8), root * CFrame.new(0, 2, 0), Color3.fromRGB(43, 45, 52), Enum.Material.Fabric)
	local torso = makePart(model, "Torso", Vector3.new(4.4, 5, 2.1), root * CFrame.new(0, 6, 0), Color3.fromRGB(57, 60, 68), Enum.Material.Fabric)
	local head = makePart(model, "Head", Vector3.new(1.9, 2.1, 1.9), root * CFrame.new(0, 9.8, 0), Color3.fromRGB(178, 174, 163), Enum.Material.SmoothPlastic)
	local hood = makePart(model, "Hood", Vector3.new(2.8, 2.7, 1.4), root * CFrame.new(0, 10, -0.65), Color3.fromRGB(39, 41, 48), Enum.Material.Fabric)
	hood.CanCollide = false

	local leftArm = makePart(model, "LeftArm", Vector3.new(1.2, 4.6, 1.2), root * CFrame.new(-3, 6.1, 0), Color3.fromRGB(55, 58, 66), Enum.Material.Fabric)
	local rightArm = makePart(model, "RightArm", Vector3.new(1.2, 4.6, 1.2), root * CFrame.new(3, 6.1, 0), Color3.fromRGB(55, 58, 66), Enum.Material.Fabric)
	leftArm.CanCollide = false
	rightArm.CanCollide = false
	legs.CanCollide = true
	torso.CanCollide = true
	head.CanCollide = false

	model.PrimaryPart = torso

	-- Лицо: два холодных огонька под капюшоном.
	for _, x in ipairs({ -0.4, 0.4 }) do
		local eye = makePart(
			model,
			"Eye",
			Vector3.new(0.18, 0.12, 0.1),
			root * CFrame.new(x, 10.1, 0.99),
			Color3.fromRGB(89, 231, 239),
			Enum.Material.Neon
		)
		eye.CanCollide = false
	end

	-- Посох.
	local staff = makePart(model, "Staff", Vector3.new(0.25, 9.4, 0.25), root * CFrame.new(4.1, 5.2, 0.6), Color3.fromRGB(88, 78, 64), Enum.Material.Wood)
	staff.CanCollide = false
	local staffTip = makePart(model, "StaffTip", Vector3.new(0.75, 0.75, 0.75), root * CFrame.new(4.1, 10.05, 0.6), Color3.fromRGB(89, 231, 239), Enum.Material.Neon)
	staffTip.Shape = Enum.PartType.Ball
	staffTip.CanCollide = false

	local orb = makePart(model, "Orb", Vector3.new(1.15, 1.15, 1.15), root * CFrame.new(-4.2, 9.1, 0.4), Color3.fromRGB(238, 193, 101), Enum.Material.Neon)
	orb.Shape = Enum.PartType.Ball
	orb.CanCollide = false
	local orbLight = Instance.new("PointLight")
	orbLight.Brightness = 2.2
	orbLight.Range = 18
	orbLight.Color = Color3.fromRGB(238, 193, 101)
	orbLight.Shadows = true
	orbLight.Parent = orb

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "TalkPrompt"
	prompt.ActionText = "Говорить"
	prompt.ObjectText = "Хранитель"
	prompt.HoldDuration = 0.15
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Parent = torso

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "NpcLabel"
	billboard.Adornee = head
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = false
	billboard.MaxDistance = 80
	billboard.Size = UDim2.fromOffset(270, 66)
	billboard.StudsOffset = Vector3.new(0, 3.1, 0)
	billboard.Parent = head

	local nameLabel = Instance.new("TextLabel")
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.new(1, 0, 0.55, 0)
	nameLabel.Font = Enum.Font.GothamBlack
	nameLabel.Text = "ХРАНИТЕЛЬ"
	nameLabel.TextColor3 = Color3.fromRGB(238, 193, 101)
	nameLabel.TextSize = 20
	nameLabel.Parent = billboard

	local subLabel = Instance.new("TextLabel")
	subLabel.BackgroundTransparency = 1
	subLabel.Position = UDim2.fromScale(0, 0.5)
	subLabel.Size = UDim2.new(1, 0, 0.4, 0)
	subLabel.Font = Enum.Font.GothamMedium
	subLabel.Text = "[E]  ОТКРЫТЬ МАГАЗИН"
	subLabel.TextColor3 = Color3.fromRGB(210, 216, 226)
	subLabel.TextSize = 13
	subLabel.Parent = billboard

	-- Вывеска над сценой.
	local sign = makePart(
		model,
		"ShopSign",
		Vector3.new(20, 4.5, 0.8),
		root * CFrame.new(0, 13.8, -3.5) * CFrame.Angles(0, math.rad(0), 0),
		Color3.fromRGB(28, 31, 38),
		Enum.Material.Metal
	)
	sign.CanCollide = false
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Back
	surface.LightInfluence = false
	surface.Parent = sign
	local signLabel = Instance.new("TextLabel")
	signLabel.BackgroundTransparency = 1
	signLabel.Size = UDim2.fromScale(1, 1)
	signLabel.Font = Enum.Font.GothamBold
	signLabel.Text = "ЛАВКА ХРАНИТЕЛЯ"
	signLabel.TextColor3 = Color3.fromRGB(89, 231, 239)
	signLabel.TextScaled = true
	signLabel.Parent = surface

	model.Parent = Workspace

	prompt.Triggered:Connect(function(player)
		if Workspace:GetAttribute("GamePhase") ~= "Lobby" then
			notificationRemote:FireClient(player, {
				text = "Хранитель закрывает лавку во время раунда.",
				tone = "warning",
			})
			return
		end
		notificationRemote:FireClient(player, {
			text = "Хранитель: «Выбери, кем станешь в следующем измерении».",
			tone = "info",
		})
		openShopRemote:FireClient(player)
	end)

	-- Лёгкая анимация парящей сферы, чтобы NPC не выглядел статуей.
	task.spawn(function()
		local base = orb.CFrame
		local startClock = os.clock()
		while orb.Parent do
			local elapsed = os.clock() - startClock
			orb.CFrame = base * CFrame.new(0, math.sin(elapsed * 1.4) * 0.22, 0) * CFrame.Angles(0, elapsed * 0.5, 0)
			task.wait(0.05)
		end
	end)

	return model
end

function LobbyService.init()
	remotesFolder = ReplicatedStorage:WaitForChild("ShatteredDimensions"):WaitForChild("Remotes")
	openShopRemote = remotesFolder:WaitForChild("OpenShop")
	notificationRemote = remotesFolder:WaitForChild("Notification")
	createNpc()
end

return LobbyService
]]></ProtectedString>
					<string name="ScriptGuid">{E2CF8A63-0819-45F7-AEFB-87794FAFB052}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">LobbyService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">553c5fda893a22240afb318a000003ea</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000016">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local ContentService = require(script.Parent:WaitForChild("ContentService"))

local MapService = {}

local MAP_ORIGIN = Vector3.new(0, 0, 4000)
local LOBBY_ORIGIN = Vector3.new(0, 0, 0)
local lobbyModel = nil
local roundModel = nil
local lastMapId = nil
local random = Random.new(os.clock() * 100000)

local PALETTE = {
	floor = Color3.fromRGB(80, 83, 88),
	floorDark = Color3.fromRGB(53, 56, 61),
	wall = Color3.fromRGB(68, 71, 77),
	wallLight = Color3.fromRGB(105, 108, 114),
	wallDark = Color3.fromRGB(42, 44, 49),
	metal = Color3.fromRGB(118, 122, 129),
	accent = Color3.fromRGB(91, 225, 235),
	danger = Color3.fromRGB(235, 78, 88),
	lamp = Color3.fromRGB(255, 236, 194),
}

local function makePart(parent, name, size, cframe, color, material)
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = true
	part.CanQuery = true
	part.CanTouch = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color or PALETTE.wall
	part.Material = material or Enum.Material.Concrete
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function addPointLight(parent, brightness, range, color)
	local light = Instance.new("PointLight")
	light.Brightness = brightness
	light.Range = range
	light.Color = color or PALETTE.lamp
	light.Shadows = true
	light.Parent = parent
	return light
end

local function addSurfaceText(part, text, color, subtitle)
	local surface = Instance.new("SurfaceGui")
	surface.Name = "Sign"
	surface.Face = Enum.NormalId.Front
	surface.LightInfluence = false
	surface.AlwaysOnTop = false
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 45
	surface.Parent = part

	local label = Instance.new("TextLabel")
	label.Name = "Title"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, if subtitle then 0.62 else 0.8)
	label.Position = UDim2.fromScale(0, if subtitle then 0.08 else 0.1)
	label.Font = Enum.Font.GothamBlack
	label.Text = text
	label.TextColor3 = color or Color3.fromRGB(234, 240, 247)
	label.TextScaled = true
	label.TextWrapped = true
	label.Parent = surface

	if subtitle then
		local lower = Instance.new("TextLabel")
		lower.Name = "Subtitle"
		lower.BackgroundTransparency = 1
		lower.Size = UDim2.fromScale(0.9, 0.22)
		lower.Position = UDim2.fromScale(0.05, 0.67)
		lower.Font = Enum.Font.GothamMedium
		lower.Text = subtitle
		lower.TextColor3 = Color3.fromRGB(145, 153, 166)
		lower.TextScaled = true
		lower.Parent = surface
	end

	return surface
end

local function createLamp(parent, cframe)
	local base = makePart(parent, "LampBase", Vector3.new(1.2, 0.6, 1.2), cframe, PALETTE.wallDark, Enum.Material.Metal)
	local pole = makePart(parent, "LampPole", Vector3.new(0.35, 11, 0.35), cframe * CFrame.new(0, 5.6, 0), PALETTE.metal, Enum.Material.Metal)
	local head = makePart(parent, "LampHead", Vector3.new(1.3, 0.45, 1.3), cframe * CFrame.new(0, 11.2, 0), Color3.fromRGB(255, 239, 198), Enum.Material.Neon)
	head.CanCollide = false
	addPointLight(head, 1.6, 32, PALETTE.lamp)
	return base, pole, head
end

local function createLobby()
	if lobbyModel then
		lobbyModel:Destroy()
	end

	local model = Instance.new("Model")
	model.Name = "SD_Lobby"
	lobbyModel = model

	local center = LOBBY_ORIGIN
	local floor = makePart(
		model,
		"LobbyFloor",
		Vector3.new(190, 2, 190),
		CFrame.new(center + Vector3.new(0, 0, 0)),
		PALETTE.floor,
		Enum.Material.Concrete
	)
	model.PrimaryPart = floor

	-- Внешние стены-парапеты.
	makePart(model, "WallNorth", Vector3.new(190, 8, 2), CFrame.new(center + Vector3.new(0, 5, -95)), PALETTE.wallDark)
	makePart(model, "WallSouth", Vector3.new(190, 8, 2), CFrame.new(center + Vector3.new(0, 5, 95)), PALETTE.wallDark)
	makePart(model, "WallEast", Vector3.new(2, 8, 190), CFrame.new(center + Vector3.new(95, 5, 0)), PALETTE.wallDark)
	makePart(model, "WallWest", Vector3.new(2, 8, 190), CFrame.new(center + Vector3.new(-95, 5, 0)), PALETTE.wallDark)

	-- Световые полосы на полу.
	local stripeOne = makePart(model, "StripeOne", Vector3.new(150, 0.12, 0.4), CFrame.new(center + Vector3.new(0, 1.08, 18)), PALETTE.accent, Enum.Material.Neon)
	stripeOne.CanCollide = false
	local stripeTwo = makePart(model, "StripeTwo", Vector3.new(150, 0.12, 0.4), CFrame.new(center + Vector3.new(0, 1.08, 22)), PALETTE.accent, Enum.Material.Neon)
	stripeTwo.CanCollide = false
	stripeTwo.Transparency = 0.45

	-- Спавн лобби.
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(center + Vector3.new(0, 1.6, 42))
	spawn.Anchored = true
	spawn.CanCollide = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Color = Color3.fromRGB(113, 117, 124)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = model

	-- Сцена и арка Хранителя.
	makePart(model, "NpcStage", Vector3.new(34, 3, 23), CFrame.new(center + Vector3.new(0, 2.5, -16)), PALETTE.floorDark, Enum.Material.Slate)
	makePart(model, "NpcStageStep", Vector3.new(20, 1.5, 5), CFrame.new(center + Vector3.new(0, 1.75, -2.5)), PALETTE.wallLight, Enum.Material.Concrete)
	makePart(model, "NpcStageStepLower", Vector3.new(24, 0.75, 4), CFrame.new(center + Vector3.new(0, 1.38, 0.5)), PALETTE.wall, Enum.Material.Concrete)

	local accentLeft = makePart(model, "StageAccentL", Vector3.new(1, 0.25, 21), CFrame.new(center + Vector3.new(-16.5, 4.1, -16)), PALETTE.accent, Enum.Material.Neon)
	accentLeft.CanCollide = false
	local accentRight = makePart(model, "StageAccentR", Vector3.new(1, 0.25, 21), CFrame.new(center + Vector3.new(16.5, 4.1, -16)), PALETTE.accent, Enum.Material.Neon)
	accentRight.CanCollide = false

	makePart(model, "ArchLeft", Vector3.new(2, 21, 3), CFrame.new(center + Vector3.new(-30, 11.5, -35)), PALETTE.wallDark, Enum.Material.Concrete)
	makePart(model, "ArchRight", Vector3.new(2, 21, 3), CFrame.new(center + Vector3.new(30, 11.5, -35)), PALETTE.wallDark, Enum.Material.Concrete)
	makePart(model, "ArchTop", Vector3.new(62, 3, 3), CFrame.new(center + Vector3.new(0, 23, -35)), PALETTE.wallDark, Enum.Material.Concrete)

	local signPart = makePart(
		model,
		"LobbySign",
		Vector3.new(54, 14, 1),
		CFrame.new(center + Vector3.new(0, 13, -92)) * CFrame.Angles(0, math.rad(180), 0),
		PALETTE.wallDark,
		Enum.Material.Metal
	)
	signPart.CanCollide = false
	addSurfaceText(signPart, "SHATTERED DIMENSIONS", PALETTE.accent, "АСИММЕТРИЧНЫЙ ХОРРОР  //  ЛОББИ")

	-- Скамейки и укрытия по краям.
	for _, side in ipairs({ -1, 1 }) do
		local x = side * 68
		local bench = makePart(model, "Bench", Vector3.new(16, 1, 4), CFrame.new(center + Vector3.new(x, 2.5, 36)), PALETTE.wall, Enum.Material.WoodPlanks)
		bench.CanCollide = true
		makePart(model, "BenchLegA", Vector3.new(1, 2, 1), CFrame.new(center + Vector3.new(x - 6, 1.5, 36)), PALETTE.wallDark, Enum.Material.Metal)
		makePart(model, "BenchLegB", Vector3.new(1, 2, 1), CFrame.new(center + Vector3.new(x + 6, 1.5, 36)), PALETTE.wallDark, Enum.Material.Metal)

		local back = makePart(model, "BenchBack", Vector3.new(16, 4, 0.6), CFrame.new(center + Vector3.new(x, 4.5, 38)), PALETTE.wallDark, Enum.Material.WoodPlanks)
		back.CanCollide = false
	end

	for _, x in ipairs({ -78, 78 }) do
		for _, z in ipairs({ -72, 70 }) do
			createLamp(model, CFrame.new(center + Vector3.new(x, 1, z)))
		end
	end

	-- Низкие баррикады, чтобы лобби не выглядело пустым.
	local barricadeOne = makePart(model, "BarricadeA", Vector3.new(28, 4.5, 1.5), CFrame.new(center + Vector3.new(-55, 3.25, -45)), PALETTE.wallLight, Enum.Material.Concrete)
	barricadeOne.CFrame *= CFrame.Angles(0, math.rad(18), 0)
	local barricadeTwo = makePart(model, "BarricadeB", Vector3.new(28, 4.5, 1.5), CFrame.new(center + Vector3.new(55, 3.25, -45)), PALETTE.wallLight, Enum.Material.Concrete)
	barricadeTwo.CFrame *= CFrame.Angles(0, math.rad(-18), 0)

	model.Parent = Workspace
end

local function buildBoundary(model, origin, name)
	makePart(model, "BoundaryNorth", Vector3.new(280, 24, 2), CFrame.new(origin + Vector3.new(0, 12, -140)), PALETTE.wallDark)
	makePart(model, "BoundarySouth", Vector3.new(280, 24, 2), CFrame.new(origin + Vector3.new(0, 12, 140)), PALETTE.wallDark)
	makePart(model, "BoundaryEast", Vector3.new(2, 24, 280), CFrame.new(origin + Vector3.new(140, 12, 0)), PALETTE.wallDark)
	makePart(model, "BoundaryWest", Vector3.new(2, 24, 280), CFrame.new(origin + Vector3.new(-140, 12, 0)), PALETTE.wallDark)

	local sign = makePart(model, "MapSign", Vector3.new(48, 12, 1), CFrame.new(origin + Vector3.new(0, 15, 138.5)), PALETTE.wallDark, Enum.Material.Metal)
	sign.CanCollide = false
	addSurfaceText(sign, name, PALETTE.accent, "ЗОНА 04  //  НЕ ОСТАНАВЛИВАЙТЕСЬ")
end

local function addCrate(model, origin, x, z, size, rotation)
	local crate = makePart(
		model,
		"Crate",
		Vector3.new(size, size, size),
		CFrame.new(origin + Vector3.new(x, 1 + size / 2, z)) * CFrame.Angles(0, math.rad(rotation or 0), 0),
		PALETTE.wallLight,
		Enum.Material.WoodPlanks
	)
	local trim = Instance.new("SurfaceGui")
	trim.Face = Enum.NormalId.Front
	trim.LightInfluence = false
	trim.Parent = crate
	local frame = Instance.new("Frame")
	frame.BackgroundColor3 = PALETTE.wallDark
	frame.BorderSizePixel = 0
	frame.Size = UDim2.fromScale(0.7, 0.08)
	frame.Position = UDim2.fromScale(0.15, 0.45)
	frame.Parent = trim
	return crate
end

local function addWallSegment(model, origin, x, z, width, depth, height, rotation)
	local wall = makePart(
		model,
		"Wall",
		Vector3.new(width, height, depth),
		CFrame.new(origin + Vector3.new(x, height / 2 + 1, z)) * CFrame.Angles(0, math.rad(rotation or 0), 0),
		PALETTE.wall,
		Enum.Material.Concrete
	)
	return wall
end

local function buildGrayPolygon(model, origin)
	-- Центральное бетонное строение с двумя выходами.
	addWallSegment(model, origin, 0, -22, 24, 2, 13, 0)
	addWallSegment(model, origin, -20, -22, 16, 2, 13, 0)
	addWallSegment(model, origin, 20, -22, 16, 2, 13, 0)
	addWallSegment(model, origin, 0, 22, 24, 2, 13, 0)
	addWallSegment(model, origin, -20, 22, 16, 2, 13, 0)
	addWallSegment(model, origin, 20, 22, 16, 2, 13, 0)
	addWallSegment(model, origin, -32, 0, 2, 24, 13, 0)
	addWallSegment(model, origin, 32, 0, 2, 24, 13, 0)

	for _, corner in ipairs({ { -26, -28 }, { 26, -28 }, { -26, 28 }, { 26, 28 } }) do
		makePart(
			model,
			"Pillar",
			Vector3.new(4, 15, 4),
			CFrame.new(origin + Vector3.new(corner[1], 8.5, corner[2])),
			PALETTE.wallLight,
			Enum.Material.Concrete
		)
	end

	-- Внутренние укрытия.
	addWallSegment(model, origin, -12, -5, 1.5, 18, 5, 0)
	addWallSegment(model, origin, 13, 9, 18, 1.5, 5, 0)
	addCrate(model, origin, 8, -7, 7, 17)
	addCrate(model, origin, 15, -3, 5, -22)
	addCrate(model, origin, -16, 12, 8, 8)
	addCrate(model, origin, -5, 11, 4, 31)

	local scatter = {
		{ -72, -65, 7, 15 }, { -88, -25, 6, -20 }, { -70, 34, 9, 8 }, { -94, 72, 5, 28 },
		{ 78, -63, 8, -13 }, { 93, -22, 5, 19 }, { 68, 39, 7, 41 }, { 91, 77, 6, -9 },
		{ -34, -78, 5, 12 }, { 28, -87, 9, 25 }, { -42, 80, 6, -26 }, { 43, 87, 7, 4 },
		{ -60, 4, 4, 33 }, { 58, -4, 5, -31 },
	}

	for _, data in ipairs(scatter) do
		addCrate(model, origin, data[1], data[2], data[3], data[4])
	end
end

local function buildLabyrinth(model, origin)
	local walls = {
		{ 0, -75, 140, 2, 12, 0 },
		{ -35, -75, 2, 55, 11, 0 },
		{ 30, -50, 2, 70, 11, 0 },
		{ 0, -20, 120, 2, 12, 0 },
		{ -50, 8, 2, 60, 11, 0 },
		{ 60, 12, 2, 90, 11, 0 },
		{ 10, 35, 120, 2, 13, 0 },
		{ -30, 60, 2, 55, 12, 0 },
		{ 35, 65, 100, 2, 10, 0 },
		{ 75, -30, 2, 45, 9, 0 },
		{ -75, 40, 2, 50, 10, 0 },
		{ -5, 92, 75, 2, 9, 0 },
	}

	for _, wall in ipairs(walls) do
		addWallSegment(model, origin, wall[1], wall[2], wall[3], wall[4], wall[5], wall[6])
	end

	for _, pillar in ipairs({
		{ -20, -42 }, { 20, -42 }, { -20, 78 }, { 20, 78 }, { 85, 82 }, { -85, 82 },
	}) do
		makePart(
			model,
			"Pillar",
			Vector3.new(5, 14, 5),
			CFrame.new(origin + Vector3.new(pillar[1], 8, pillar[2])),
			PALETTE.wallDark,
			Enum.Material.Concrete
		)
	end

	for _, crate in ipairs({
		{ -58, -45, 6, 14 }, { 55, -60, 7, -18 }, { -15, -50, 5, 28 },
		{ 48, 18, 8, 4 }, { -38, 26, 7, -26 }, { 20, 60, 5, 19 },
		{ -62, 84, 6, 37 }, { 78, 52, 5, -7 },
	}) do
		addCrate(model, origin, crate[1], crate[2], crate[3], crate[4])
	end

	createLamp(model, CFrame.new(origin + Vector3.new(-115, 1, -90)))
	createLamp(model, CFrame.new(origin + Vector3.new(110, 1, 95)))
end

local function buildAshYard(model, origin)
	local containers = {
		{ -62, -20, 26, 9, 9, 0 },
		{ -58, 28, 26, 9, 9, 0 },
		{ 62, -22, 26, 9, 9, 0 },
		{ 67, 26, 26, 9, 9, 0 },
		{ -4, 65, 32, 9, 9, 0 },
		{ -12, -58, 9, 9, 26, 0 },
		{ 25, -22, 9, 9, 26, 0 },
	}

	for index, data in ipairs(containers) do
		local containerColor = if index % 2 == 0 then Color3.fromRGB(92, 75, 70) else Color3.fromRGB(74, 82, 88)
		local container = makePart(
			model,
			"Container" .. tostring(index),
			Vector3.new(data[3], data[4], data[5]),
			CFrame.new(origin + Vector3.new(data[1], 5.5, data[2])) * CFrame.Angles(0, math.rad(data[6]), 0),
			containerColor,
			Enum.Material.CorrodedMetal
		)
		container.CanCollide = true

		local door = makePart(
			model,
			"ContainerDoor",
			Vector3.new(data[3] * 0.8, data[4] * 0.7, 0.3),
			container.CFrame * CFrame.new(0, 0, data[5] / 2 + 0.2),
			PALETTE.wallDark,
			Enum.Material.Metal
		)
		door.CanCollide = false
	end

	addWallSegment(model, origin, -20, 0, 2, 48, 8, 0)
	addWallSegment(model, origin, 30, 0, 2, 48, 8, 0)
	addWallSegment(model, origin, 0, -38, 38, 2, 6, 0)

	local towerBase = makePart(model, "TowerBase", Vector3.new(14, 4, 14), CFrame.new(origin + Vector3.new(0, 3, 100)), PALETTE.wallDark, Enum.Material.Concrete)
	makePart(model, "TowerMiddle", Vector3.new(10, 7, 10), CFrame.new(origin + Vector3.new(0, 8.5, 100)), PALETTE.wall, Enum.Material.Concrete)
	makePart(model, "TowerPlatform", Vector3.new(16, 1, 16), CFrame.new(origin + Vector3.new(0, 12.5, 100)), PALETTE.wallLight, Enum.Material.Metal)
	createLamp(model, CFrame.new(origin + Vector3.new(0, 13, 100)))

	for _, crate in ipairs({
		{ -100, -110, 6, 11 }, { 106, -104, 7, -8 }, { -110, 20, 5, 22 },
		{ 105, 62, 8, 0 }, { 72, 105, 5, 32 }, { -80, 104, 6, -12 },
	}) do
		addCrate(model, origin, crate[1], crate[2], crate[3], crate[4])
	end

	createLamp(model, CFrame.new(origin + Vector3.new(-115, 1, 115)))
	createLamp(model, CFrame.new(origin + Vector3.new(115, 1, -115)))
end

