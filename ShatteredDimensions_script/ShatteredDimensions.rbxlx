		Position = UDim2.new(0.55, 0, 0, 0),
		Size = UDim2.new(0, 1, 1, 0),
		ZIndex = 5,
	}, content)

	-- Правая колонка.
	local detail = UILib.new("Frame", {
		Name = "Details",
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.16,
		BorderSizePixel = 0,
